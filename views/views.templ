package views

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/atomic77/nethadone/models"
)

var navLinks = []struct{ Href, Name string }{
	{"/", "Status"},
	{"/policies", "Policies"},
	{"/globs", "Globs"},
	{"/bandwidth", "Bandwidth"},
	{"/clients", "Clients"},
	{"/shaping", "Shaping"},
}

// hx-boost turns links and forms into ajax body swaps, so navigation keeps the page loaded.
templ layout(title, path string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content={ htmxConfig }/>
			<title>{ title } · Nethadone</title>
			<link rel="icon" href="/static/laptop.svg"/>
			<link rel="stylesheet" href="/static/pico.min.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body hx-boost="true">
			<header class="container">
				<nav>
					<ul><li><strong>Nethadone</strong></li></ul>
					<ul>
						for _, l := range navLinks {
							<li>
								<a href={ templ.SafeURL(l.Href) } if l.Href == path {
									aria-current="page"
								}>{ l.Name }</a>
							</li>
						}
					</ul>
				</nav>
			</header>
			<main class="container">
				{ children... }
			</main>
		</body>
	</html>
}

templ Status(lan, wan string, nGlobs, nPolicies int, ifaces []models.Iface) {
	@layout("Status", "/") {
		<h2>Status</h2>
		<div class="grid">
			<article><header>LAN</header><strong>{ lan }</strong></article>
			<article><header>WAN</header><strong>{ wan }</strong></article>
			<article><header>Glob groups</header><a href="/globs"><strong>{ strconv.Itoa(nGlobs) }</strong></a></article>
			<article><header>Throttling policies</header><a href="/policies"><strong>{ strconv.Itoa(nPolicies) }</strong></a></article>
		</div>
		<h3>Interfaces</h3>
		<div class="overflow-auto">
			<table class="striped">
				<thead><tr><th>Name</th><th>State</th><th>Addresses</th></tr></thead>
				<tbody>
					for _, i := range ifaces {
						<tr>
							<td>{ i.Name }</td>
							<td>
								if i.Up {
									up
								} else {
									<mark>down</mark>
								}
							</td>
							<td>{ strings.Join(i.Addrs, ", ") }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// classLabel describes a bandwidth class, e.g. "250 kbit/s, +20 ms".
templ Policies(policies []models.Policy, classLabel func(int) string) {
	@layout("Policies", "/policies") {
		<hgroup>
			<h2>Throttling policies</h2>
			<p>One per (device, glob group) currently being slowed down. Refreshes every 10 seconds.</p>
		</hgroup>
		<div id="policies" class="overflow-auto" hx-get="/policies" hx-trigger="every 10s" hx-select="#policies" hx-swap="outerHTML">
			<table class="striped">
				<thead><tr><th>Device IP</th><th>Glob group</th><th>Class</th><th>Bandwidth</th><th>Since (UTC)</th></tr></thead>
				<tbody>
					for _, p := range policies {
						<tr>
							<td>{ p.SrcIp }</td>
							<td>{ p.GlobGroup }</td>
							<td>{ strconv.Itoa(p.Class) }</td>
							<td>{ classLabel(p.Class) }</td>
							<td>{ p.Tstamp.Format("2006-01-02 15:04:05") }</td>
						</tr>
					}
					if len(policies) == 0 {
						<tr><td colspan="5">Nothing is being throttled right now.</td></tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ Globs(globs []models.GlobGroup, form models.GlobGroup, errMsg string) {
	@layout("Globs", "/globs") {
		<hgroup>
			<h2>Glob groups</h2>
			<p>Wildcard patterns matched against domains seen in DNS answers, e.g. <code>*.reddit.com</code>. Traffic to matching sites is throttled when used heavily.</p>
		</hgroup>
		<div class="overflow-auto">
			<table class="striped">
				<thead><tr><th>Name</th><th>Glob</th><th>Description</th><th></th></tr></thead>
				<tbody>
					for _, g := range globs {
						<tr>
							<td>{ g.Name }</td>
							<td><code>{ g.Glob }</code></td>
							<td>{ g.Description }</td>
							<td>
								<form method="post" action="/globs/delete" hx-confirm={ "Delete glob group " + g.Name + "?" } style="margin:0">
									<input type="hidden" name="name" value={ g.Name }/>
									<button type="submit" class="secondary outline" style="margin:0">Delete</button>
								</form>
							</td>
						</tr>
					}
					if len(globs) == 0 {
						<tr><td colspan="4">No glob groups yet. Add one below.</td></tr>
					}
				</tbody>
			</table>
		</div>
		<article>
			<header>Add a glob group</header>
			<form method="post" action="/globs">
				if errMsg != "" {
					<p role="alert"><mark>{ errMsg }</mark></p>
				}
				<div class="grid">
					<label>Name <input name="name" required value={ form.Name }/></label>
					<label>Glob <input name="glob" required placeholder="*.instagram.com" value={ form.Glob }/></label>
					<label>Description <input name="description" value={ form.Description }/></label>
				</div>
				<button type="submit">Add</button>
			</form>
		</article>
	}
}

func bandwidthPageURL(page int) string {
	return "/bandwidth?page=" + strconv.Itoa(page)
}

templ Bandwidth(rows []models.Bandwidth, page, pages, total int) {
	@layout("Bandwidth", "/bandwidth") {
		<hgroup>
			<h2>Data usage</h2>
			<p>Bytes each device has downloaded from each remote IP, largest first. Refreshes every 30 seconds.</p>
		</hgroup>
		<div id="bandwidth" class="overflow-auto" hx-get={ bandwidthPageURL(page) } hx-trigger="every 30s" hx-select="#bandwidth" hx-swap="outerHTML">
			<nav aria-label="Pagination">
				<ul>
					<li>{ strconv.Itoa(total) } IP pairs · page { strconv.Itoa(page) } of { strconv.Itoa(pages) }</li>
				</ul>
				<ul>
					if page > 1 {
						<li><a href={ templ.SafeURL(bandwidthPageURL(page - 1)) }>Previous</a></li>
					}
					if page < pages {
						<li><a href={ templ.SafeURL(bandwidthPageURL(page + 1)) }>Next</a></li>
					}
				</ul>
			</nav>
			<table class="striped">
				<thead><tr><th>Device IP</th><th>Remote IP</th><th>Likely domain</th><th>Glob group</th><th>Received</th></tr></thead>
				<tbody>
					for _, b := range rows {
						<tr>
							<td>{ b.SrcIpAddr.String() }</td>
							<td>{ b.DestIpAddr.String() }</td>
							<td>{ b.ProbDomain }</td>
							<td>{ b.GlobName }</td>
							<td>{ fmtBytes(b.Bytes) }</td>
						</tr>
					}
					if len(rows) == 0 {
						<tr><td colspan="5">No traffic seen yet.</td></tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ Clients(clients []models.Client) {
	@layout("Clients", "/clients") {
		<hgroup>
			<h2>Clients</h2>
			<p>Devices on the LAN, from traffic counters, the neighbour (ARP) table and DHCP leases. Refreshes every 30 seconds.</p>
		</hgroup>
		<div id="clients" class="overflow-auto" hx-get="/clients" hx-trigger="every 30s" hx-select="#clients" hx-swap="outerHTML">
			<table class="striped">
				<thead><tr><th>IP</th><th>Hostname</th><th>MAC</th><th>State</th><th>Received</th><th>Remote IPs</th><th>Glob groups</th></tr></thead>
				<tbody>
					for _, c := range clients {
						<tr>
							<td>{ c.IpAddr.String() }</td>
							<td>{ c.Hostname }</td>
							<td>
								<code>{ c.Mac }</code>
								if c.Randomised {
									<small data-tooltip="Locally administered (randomised) MAC"> private</small>
								}
							</td>
							<td>{ c.State }</td>
							<td>{ fmtBytes(c.Bytes) }</td>
							<td>{ strconv.Itoa(c.Remotes) }</td>
							<td>{ strings.Join(c.Globs, ", ") }</td>
						</tr>
					}
					if len(clients) == 0 {
						<tr><td colspan="7">No clients seen yet.</td></tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ Shaping(s models.SysStats, tree []models.TcNode) {
	@layout("Shaping", "/shaping") {
		<hgroup>
			<h2>Shaping</h2>
			<p>Live kernel counters for the LAN traffic-shaping tree. Rates are averaged since the previous refresh (every 5 seconds).</p>
		</hgroup>
		<div id="shaping" hx-get="/shaping" hx-trigger="every 5s" hx-select="#shaping" hx-swap="outerHTML">
			<div class="grid">
				<article>
					<header>System</header>
					up { s.Uptime.String() }<br/>
					load { fmt.Sprintf("%.2f %.2f %.2f", s.Load[0], s.Load[1], s.Load[2]) }<br/>
					{ fmtBytes(s.MemAvail) } of { fmtBytes(s.MemTotal) } RAM available
				</article>
				<article>
					<header>Throttler</header>
					{ strconv.Itoa(s.Rules) } rules
					if !s.RulesAt.IsZero() {
						, rebuilt { s.RulesAt.UTC().Format("15:04:05") } UTC
					}
					<br/>
					{ strconv.FormatUint(s.Throttled, 10) } of { strconv.FormatUint(s.Scanned, 10) } packets throttled since then
				</article>
			</div>
			<h3>Interfaces</h3>
			<div class="overflow-auto">
				<table class="striped">
					<thead><tr><th></th><th>Interface</th><th>Received</th><th>Rx rate</th><th>Sent</th><th>Tx rate</th><th>Drops (rx/tx)</th></tr></thead>
					<tbody>
						for _, i := range s.Ifaces {
							<tr>
								<td>{ i.Role }</td>
								<td>{ i.Name }</td>
								<td>{ fmtBytes(i.RxBytes) }</td>
								<td>{ fmtBits(i.RxBps * 8) }</td>
								<td>{ fmtBytes(i.TxBytes) }</td>
								<td>{ fmtBits(i.TxBps * 8) }</td>
								<td>{ strconv.FormatUint(i.RxDrops, 10) } / { strconv.FormatUint(i.TxDrops, 10) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<h3>HTB tree</h3>
			<p>Traffic towards LAN devices. Unmatched traffic goes to the default class; throttled pairs are sent to slower leaves.</p>
			<div class="overflow-auto">
				<table class="striped">
					<thead><tr><th>Handle</th><th>Type</th><th>Limit</th><th>Rate now</th><th>Sent</th><th>Packets</th><th>Drops</th><th>Overlimits</th><th>Backlog</th><th>Policies</th></tr></thead>
					<tbody>
						for _, n := range tree {
							<tr>
								<td style={ fmt.Sprintf("padding-left:%.1frem", 0.5+1.5*float64(n.Depth)) }><code>{ n.Handle }</code></td>
								<td>{ n.Kind }</td>
								<td>
									if n.CeilBits > 0 {
										{ fmtBits(float64(n.CeilBits)) }
									}
									if n.DelayMs > 0 {
										+{ fmt.Sprintf("%.0f", n.DelayMs) } ms
									}
									if n.DefaultCls != "" {
										default { n.DefaultCls }
									}
								</td>
								<td>{ fmtBits(n.Bps * 8) }</td>
								<td>{ fmtBytes(n.Bytes) }</td>
								<td>{ strconv.FormatUint(n.Packets, 10) }</td>
								<td>{ strconv.FormatUint(uint64(n.Drops), 10) }</td>
								<td>{ strconv.FormatUint(uint64(n.Overlimits), 10) }</td>
								<td>{ fmtBytes(uint64(n.Backlog)) }</td>
								<td>{ strings.Join(n.Policies, ", ") }</td>
							</tr>
						}
						if len(tree) == 0 {
							<tr><td colspan="10">No qdiscs found on the LAN interface.</td></tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}
